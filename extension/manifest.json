{
  "manifest_version": 3,
  "name": "Bookmarker",
  "version": "1.0.0",
  "description": "Save the current tab to Bookmarker, with tags and a folder.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to Bookmarker"
  },
  "options_page": "options.html",
  "icons": { "48": "icon.png", "128": "icon.png" },
  "permissions": ["activeTab", "storage"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+S", "mac": "Command+Shift+S" },
      "description": "Save this tab to Bookmarker"
    }
  }
}
