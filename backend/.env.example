# MongoDB
MONGODB_URI=mongodb://localhost:27017/bookmarker

# Google OAuth
# Set these up at Google Cloud Console (https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:8080/auth/google/callback

# JWT
# Used to securely sign the authentication cookie. Should be a long, random secret.
JWT_SECRET=change-this-to-a-long-random-string-in-production

# App
# URL to your frontend application. Used for CORS and redirects.
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
PORT=8080

# Logging
# Valid values: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info
# Toggle whether to log every HTTP request (true/false)
LOG_HTTP_REQUESTS=false

# Optional: requests per minute per IP (default 100)
# THROTTLE_LIMIT=100

# Optional: short summaries and tag suggestions written by Claude on save
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-haiku-5-5

# Optional: send the weekly digest email (users opt in under "Weekly digest")
# SMTP_URL=smtps://user:password@smtp.example.com
# MAIL_FROM="Bookmarker <no-reply@example.com>"

# Plans and codes
# Comma-separated emails that can create and manage access/discount codes.
ADMIN_EMAILS=
# Prices in the smallest currency unit (cents) and the currency shown in the app.
PRICE_MONTHLY=499
PRICE_YEARLY=3999
PRICE_CURRENCY=USD
