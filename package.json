{
  "name": "bookmarker",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "start:backend": "npm run start:dev --prefix backend",
    "start:frontend": "npm run dev --prefix frontend",
    "build": "concurrently \"npm run build --prefix backend\" \"npm run build --prefix frontend\"",
    "generate:api": "concurrently \"npm run generate:api:frontend\" \"npm run generate:api:backend\"",
    "generate:api:frontend": "openapi -i ./openapi.yaml -o ./frontend/src/api-client -c fetch",
    "generate:api:backend": "openapi -i ./openapi.yaml -o ./backend/src/api-types --exportCore false --exportServices false",
    "watch:api": "node --watch-path=./openapi.yaml -e \"require('child_process').execSync('npm run generate:api', {stdio: 'inherit'})\"",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@hey-api/client-fetch": "^0.13.1",
    "@hey-api/openapi-ts": "^0.99.0",
    "concurrently": "^10.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "openapi-typescript-codegen": "^0.31.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  }
}
