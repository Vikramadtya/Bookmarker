VITE_API_URL=http://localhost:8080/api/v1

# Logging
VITE_LOG_LEVEL=info

# Production (Vercel): proxy the API through the frontend's own domain so auth
# cookies stay first-party (Safari blocks cross-site cookies). frontend/vercel.json
# rewrites /api and /auth to the backend; update its destination to your backend.
# VITE_API_URL=/api/v1
# VITE_SOCKET_URL=https://your-backend.onrender.com
